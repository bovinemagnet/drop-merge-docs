<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="{{{or site.url siteRootPath}}}">
        <img class="brand-mark" src="{{{uiRootPath}}}/img/fruits/watermelon.png" alt="">
        <span>{{site.title}}</span>
      </a>
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <input id="search-input" type="text" placeholder="Search the docs"{{#if page.home}} autofocus{{/if}}>
        </div>
      </div>
      {{/if}}
      <button class="navbar-burger" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        {{! Shortcuts are root-relative URLs into the drop-and-merge component;
            relativize rewrites them for the page currently being rendered. }}
        <a class="navbar-item" href="{{{relativize (or site.homeUrl siteRootPath)}}}">Home</a>
        <a class="navbar-item" href="{{{relativize '/drop-and-merge/main/gameplay.html'}}}">How to play</a>
        <a class="navbar-item" href="{{{relativize '/drop-and-merge/main/games.html'}}}">The games</a>
        <a class="navbar-item" href="{{{relativize '/drop-and-merge/main/faq.html'}}}">FAQ</a>
        <div class="navbar-item">
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
            <span class="icon-light" aria-hidden="true">&#9789;</span>
            <span class="icon-dark" aria-hidden="true">&#9788;</span>
          </button>
        </div>
        <div class="navbar-item">
          <span class="control">
            <a class="button is-primary" href="{{{relativize '/drop-and-merge/main/store-listings.html'}}}">Get the game</a>
          </span>
        </div>
      </div>
    </div>
  </nav>
</header>
